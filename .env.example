# Variante A — Claude via Anthropic API
ANTHROPIC_API_KEY=

# Variantes B e C — provider OpenAI-compatible (Together AI em runtime; ver ADR-002 no tech-stack)
LLM_API_KEY=
LLM_BASE_URL=https://api.together.xyz/v1
LLM_AGENT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
LLM_GUARD_MODEL=meta-llama/Llama-Guard-4-12B

# Groq — legado (era o provider original de B/C; mantido para smoke test alternativo)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Buyer key usada pela harness de red team — obtida do DB após o seed:
#   docker exec <db-container> psql -U postgres -d paychat -t \
#     -c "SELECT api_key FROM users WHERE role='buyer' LIMIT 1;"
HARNESS_BUYER_API_KEY=

# Infraestrutura local (docker compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paychat
REDIS_URL=redis://localhost:6379
CHROMA_URL=http://localhost:8001

# Presidio — mock regex no host (scripts/presidio_mock.py), não o container Analyzer real
PRESIDIO_URL=http://localhost:3000
